# Hyderabad Desk worker — copy to worker/.env and fill in.
#
# SECRET. This file's real counterpart (worker/.env) is gitignored and must
# only ever live on the Pi (or your laptop while testing). The service_role
# key bypasses row level security — it must NEVER appear in the frontend,
# in a VITE_* variable, or in the Vercel project.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=PASTE_HERE

# Supabase → Project Settings → API Keys → service_role (click to reveal)
SUPABASE_SERVICE_ROLE_KEY=PASTE_HERE

# platform.claude.com → API keys
ANTHROPIC_API_KEY=PASTE_HERE

# --- Reddit API (OPTIONAL) ---------------------------------------------
# Leave these unset to fetch the public .json endpoint with a browser
# User-Agent — enough for a low-volume personal dashboard.
#
# If Reddit's WAF still blocks the worker (a 403 "blocked by network
# security"), register a free "script" app at
# https://www.reddit.com/prefs/apps and paste its two values here. The
# worker then authenticates every request against the official API and is
# never WAF-blocked. No Reddit account password is needed.
#   REDDIT_CLIENT_ID     = the string under the app name ("personal use script")
#   REDDIT_CLIENT_SECRET = the "secret" field
# REDDIT_CLIENT_ID=PASTE_HERE
# REDDIT_CLIENT_SECRET=PASTE_HERE
