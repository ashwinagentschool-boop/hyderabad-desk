# Hyderabad Desk worker — copy to worker/.env and fill in.
#
# SECRET. This file's real counterpart (worker/.env) is gitignored and must
# only ever live on the Pi (or your laptop while testing). The service_role
# key bypasses row level security — it must NEVER appear in the frontend,
# in a VITE_* variable, or in the Vercel project.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=PASTE_HERE

# Supabase → Project Settings → API Keys → service_role (click to reveal)
SUPABASE_SERVICE_ROLE_KEY=PASTE_HERE

# platform.claude.com → API keys
ANTHROPIC_API_KEY=PASTE_HERE

# No Reddit credentials are needed: the worker fetches the public .json
# endpoint with a descriptive User-Agent. See PI_SETUP.md if you ever hit a
# persistent 403.
