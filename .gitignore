# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Environment — never commit keys. VITE_DATA_MODE stays unset (= mock) for now;
# Supabase variables get set in the Vercel project, not in the repo.
.env
.env.*
!.env.example

# Vercel
.vercel

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tooling
.gstack/

# Third-party agent skills installed via `npx skills add`.
# Reproducible from skills-lock.json; .claude/skills/* are junctions to
# .agents/skills/*, so committing both would duplicate every file.
.agents/
.claude/
skills-lock.json

# Python worker
.venv/
worker/.venv/
__pycache__/
*.pyc
