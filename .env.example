# Hyderabad Desk frontend — copy to .env.local and fill in.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything
# here IS public by design. The Supabase anon key is safe to ship: row
# level security is what protects the data. The service_role key must
# never appear in this file or anywhere else in the frontend.
#
# Leave this file unused (no .env.local) to keep running on mock adapters.

# 'live' switches reddit + leads + settings + status to Supabase and turns
# on the login gate. Anything else (or unset) means mock, exactly as today.
VITE_DATA_MODE=live

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=PASTE_HERE

# Supabase → Project Settings → API Keys → anon / publishable
VITE_SUPABASE_ANON_KEY=PASTE_HERE
